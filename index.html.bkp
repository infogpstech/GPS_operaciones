<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GOS - GPS Operations Suite</title>
    <link rel="icon" type="image/svg+xml" href="logo-gos.svg">
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <link rel="stylesheet" href="Interfaces/vistas/style.css">
    <!-- Google Maps API Placeholder - Reemplazar con clave real en producción -->
</head>
<body>
    <div id="app">
<!-- Toast Notificación -->
        <div id="toast" class="toast"></div>

        <!-- Auth View -->
        <div id="login-view" class="login-container">
            <div class="login-card">
                <h2>Iniciar Sesión - GOS</h2>
                <form id="login-form">
                    <div class="form-group">
                        <label>Usuario</label>
                        <input type="text" id="username" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Contraseña</label>
                        <input type="password" id="password" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Acceder</button>
                    <p id="login-error" style="color: var(--danger); margin-top: 10px; display: none;"></p>
                </form>
            </div>
        </div>

        <!-- Main View -->
        <div id="main-view" style="display: none;">
            <nav class="navbar">
                <div class="brand">GOs | GPS Operations Suite</div>

                <!-- Búsqueda Global en Navbar -->
                <div class="navbar-search-container" id="global-search-container" style="position:relative; margin: 0 15px; flex-grow: 1; max-width: 300px;">
                    <input type="text" id="global-search-input" class="form-control" placeholder="🔍 Buscar órdenes, clientes, VIN..." style="padding: 6px 12px; border-radius: 20px; font-size:0.85rem; background:#4a5568; border:1px solid #718096; color:white; width:100%;">
                    <div id="global-search-results" class="autocomplete-suggestions" style="display:none; position:absolute; z-index:1000; width:100%; top:100%; left:0; background:white; border:1px solid #ddd; max-height: 250px; overflow-y:auto; color:var(--dark);"></div>
                </div>

                <!-- Centro de Notificaciones en Navbar -->
                <div class="navbar-notifications-container" style="position:relative; margin-right: 15px; cursor:pointer;">
                    <span id="nav-notification-bell" style="font-size:1.3rem; position:relative;">
                        🔔
                        <span id="notification-counter" style="position:absolute; top:-5px; right:-8px; background:var(--danger); color:white; border-radius:50%; width:18px; height:18px; font-size:0.7rem; font-weight:bold; display:flex; align-items:center; justify-content:center; display:none;">0</span>
                    </span>
                    <div id="notification-dropdown" class="autocomplete-suggestions" style="display:none; position:absolute; right:0; top:120%; width:320px; z-index:1000; max-height:350px; overflow-y:auto; padding:10px; background:white; border:1px solid #ddd; border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,0.15); color:var(--dark);">
                        <h4 style="margin:0 0 10px 0; border-bottom:1px solid #eee; padding-bottom:5px; display:flex; justify-content:space-between; font-size:0.9rem;">
                            <span>🔔 Notificaciones</span>
                            <a href="#" id="clear-notifications-link" style="font-size:0.75rem; text-decoration:none; color:var(--primary);">Limpiar todo</a>
                        </h4>
                        <div id="notification-items-list" style="display:flex; flex-direction:column; gap:8px;">
                            <p style="color:var(--secondary); font-style:italic; font-size:0.8rem; margin:0; padding:10px; text-align:center;">No hay notificaciones activas</p>
                        </div>
                    </div>
                </div>

                <div class="nav-links">
                    <a href="#" class="nav-link" data-section="agenda">Agenda</a>
                    <a href="#" class="nav-link" data-section="dashboard">Planificación de la semana</a>
                    <a href="#" class="nav-link" data-section="reportes">Reportes</a>
                    <a href="#" class="nav-link" data-section="ordenes">Órdenes</a>
                    <a href="#" class="nav-link" data-section="consulta">Consulta Técnica</a>
                    <a href="#" class="nav-link" data-section="clientes">Clientes</a>
                    <a href="#" class="nav-link" data-section="tecnicos">Técnicos</a>
                    <a href="#" class="nav-link" data-section="admin" id="nav-admin" style="display:none;">Administración</a>
                    <a href="#" id="logout-btn" class="nav-link">Cerrar Sesión</a>
                </div>
            </nav>
            <div class="container">
                <header>
                    <div style="display:flex; justify-content: space-between; align-items: center;">
                        <h1 id="welcome-msg">Bienvenido</h1>
                        <small style="opacity: 0.5;">v0.7.1</small>
                    </div>
                    <h2 id="section-title">Dashboard</h2>
                </header>
                <main id="content">
                    <!-- Dynamic Content -->
                    <div id="section-content">
                        <p>Seleccione una opción del menú para comenzar.</p>
                    </div>
                </main>
            </div>
        </div>
    </div>
    <script type="module" src="main.js"></script>
</body>
</html>
